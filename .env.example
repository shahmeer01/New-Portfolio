# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for the contact form to send emails.
# Create a free account at https://resend.com and add an API key (e.g. re_...).
# Keep this secret — it is read server-side only and never exposed to the browser.
RESEND_API_KEY=""

# CONTACT_TO_EMAIL: The inbox that receives contact form submissions.
CONTACT_TO_EMAIL="shahmeertalib5960@gmail.com"

# CONTACT_FROM_EMAIL: Sender address shown on received emails.
# Use "onboarding@resend.dev" while testing (Resend only delivers to your own email).
# For production, verify a domain in Resend and use something like "contact@yourdomain.com".
CONTACT_FROM_EMAIL="onboarding@resend.dev"
